# .streamlit/secrets.toml
# Copy this file to .streamlit/secrets.toml and fill in your details
# For Streamlit Cloud hosting, add these in the Secrets section of your app settings

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your.email@gmail.com"
SMTP_PASSWORD = "your_gmail_app_password"
FROM_NAME = "Office Project Manager"
