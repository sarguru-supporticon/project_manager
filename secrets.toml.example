# =============================================================
# secrets.toml.example  —  SAFE TO COMMIT (no real values here)
# =============================================================
#
# ── LOCAL DEVELOPMENT ────────────────────────────────────────
# Copy this file to  .streamlit/secrets.toml  and fill in your
# real values.  That file is in .gitignore and will NOT be
# pushed to GitHub.
#
# ── STREAMLIT CLOUD (production) ─────────────────────────────
# Do NOT use GitHub Secrets for this app.
# Instead, open your Streamlit Cloud dashboard:
#   https://share.streamlit.io/
#   → Your app → ⋮ (kebab menu) → Settings → Secrets
# Paste the lines below (without this comment block) and fill
# in your real values, then click Save.
#
# ── HOW TO GET A GMAIL APP PASSWORD ──────────────────────────
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → "Other (custom name)".
# 4. Paste the 16-character code as SMTP_PASSWORD below.
# =============================================================

SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = 587
SMTP_USER     = "your.email@gmail.com"
SMTP_PASSWORD = "your_16char_app_password"
FROM_NAME     = "Office Project Manager"
